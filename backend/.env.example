# Copy to backend/.env and configure at least one LLM provider below —
# Amazon Nova on Bedrock (primary) and/or Google Gemini (keyed fallback).
# See llm/providers.py. A provider with no model/key set is skipped.

# Amazon Nova on AWS Bedrock (llm/providers.py's NovaProvider) — auth is the
# ambient AWS credential chain, the same one documents/ocr_client.py's
# Lambda invoke already relies on; no separate key needed here. Must be a
# region-prefixed inference-profile ID, not the bare model ID.
NOVA_MODEL=
NOVA_REGION=us-east-1

# Google Gemini (llm/providers.py's GeminiProvider) — a keyed fallback so
# extraction and scripts/generate_predictions_and_score.py keep working when
# Bedrock is unavailable. Get a key at https://aistudio.google.com/apikey
# and paste it here. Leave blank to disable Gemini entirely.
# Supports the image+OCR-text pairing the extraction pipeline relies on.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated, tried in order, first success wins (llm/chain.py falls
# through to the next provider on any failure). Use "nova,gemini" to fall
# back automatically when Bedrock errors; "gemini" alone to force Gemini.
LLM_PROVIDER_ORDER=nova
LLM_TIMEOUT_SECONDS=30

# documents/pipeline.py's completed_application_form (whole-form) extraction
# uses this order instead of LLM_PROVIDER_ORDER — kept as its own setting in
# case a many-section whole-form run ever needs a different provider order,
# though today both resolve to the same single provider.
CHUNKED_EXTRACTION_PROVIDER_ORDER=nova

# deepreef-ocr: invoked directly via the AWS SDK (boto3 lambda.invoke), same
# as pcsapaiv2 production. Needs AWS credentials in the environment (profile
# or access keys) with lambda:InvokeFunction on this function.
OCR_LAMBDA_FUNCTION_NAME=akash-ocr
OCR_LAMBDA_REGION=ap-south-1
OCR_TIMEOUT_SECONDS=30

# Local OCR for English/Latin scans is RapidOCR (documents/local_ocr.py) —
# the same engine (rapidocr-onnxruntime) the deepreef-ocr sibling project's
# Lambda runs for every other script, using RapidOCR's own bundled default
# model instead of one of deepreef-ocr's baked non-English .onnx files, in
# process (no AWS call, no Docker). Real per-line bounding boxes the LLM
# vision fallback never could give. No config needed here: `pip install
# rapidocr-onnxruntime` pulls everything required, and its default model
# ships inside the package itself — nothing downloads at runtime.

# RAG pipeline for the "completed_application_form" doc_type (15+ page whole
# form uploads) — see documents/chunking.py, embeddings.py, vector_store.py,
# retrieval.py. Sentence Transformers embeds each page; Qdrant runs embedded
# (on-disk, no server/Docker) so only the pages relevant to a given form
# section get sent to the LLM at all.
EMBEDDING_MODEL=all-MiniLM-L6-v2
QDRANT_STORAGE_DIR=./qdrant_storage
RETRIEVAL_TOP_K=4

DATABASE_URL=sqlite:///./nabl.db
STORAGE_DIR=./storage
CONFIDENCE_THRESHOLD=0.85
